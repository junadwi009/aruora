# Copy to repository-root .env; never commit the populated copy.
# This is an isolated UAT environment, never an existing production database.
SESSION_SECRET=
POSTGRES_USER=aruora
POSTGRES_PASSWORD=
POSTGRES_DB=aruora_uat
# Public HTTPS hostname/origin, no trailing slash in APP_BASE_URL.
TRUSTED_HOSTS=
APP_BASE_URL=
# Runtime role and migration role may be separated. URL-encode credentials.
# DATABASE_URL=
# MIGRATION_DATABASE_URL=
# Safest UAT start: static fixtures, no paid inference.
LLM_MODE=stub
AI_BUDGET_KILL=0
AI_DAILY_BUDGET_MICROS=1000000
EMAIL_VERIFICATION_REQUIRED=1
FAIL_CLOSED_ON_MAIL=1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GOOGLE_CLIENT_ID=
APP_PASSCODE=
ADMIN_EMAILS=
ADMIN_TOTP_SECRET=
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Must reflect the actual TLS-edge -> nginx -> gunicorn trusted-hop topology.
TRUSTED_PROXIES=1
TRUSTED_PROXY_PROTO=0
