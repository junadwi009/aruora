# LLM configuration
LLM_MODE=stub
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_GENERATE=anthropic/claude-haiku-4-5
MODEL_SCORE=anthropic/claude-sonnet-4-6

# Database
DATABASE_URL=

# Server
CORS_ORIGIN=http://localhost:5173

# ── Security (REQUIRED for any non-local deployment) ─────────────────────────
# Signs session cookies AND password-reset tokens. The app refuses to start
# (outside tests) if this is left at the insecure built-in default.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Send the session cookie only over HTTPS. Set to 1 in production (behind TLS).
COOKIE_SECURE=0
# SameSite policy for the session cookie (Lax is the CSRF-safe default).
COOKIE_SAMESITE=Lax
# In-process rate limiting (brute-force + LLM cost-abuse guard). 1=on.
RATE_LIMIT_ENABLED=1

# ── WS03 identity/session hardening ──────────────────────────────────────────
# Server-side sessions live in PostgreSQL; abuse counters (login throttles,
# register/forgot/reset bursts) are shared across workers via Redis. Production
# MUST set REDIS_URL so the controls are global, not per-process.
REDIS_URL=
# NIST-style new-password minimum (single-factor accounts).
MIN_PASSWORD_CHARS=15
# Absolute cap (hours) for non-remembered sessions; remembered ones cap at
# REMEMBER_DAYS (7) regardless of activity.
SESSION_ABSOLUTE_HOURS=12
# When 1, locally-registered accounts must verify email ownership before using
# expensive (LLM) features. Requires SMTP configured below (startup fails
# otherwise — WS03-06B). Google accounts inherit the provider email_verified.
EMAIL_VERIFICATION_REQUIRED=0
# Fail startup when email flows are enabled but SMTP is missing (set 1 in prod).
FAIL_CLOSED_ON_MAIL=0
# Optional shared base32 TOTP secret: when set, admin logins and destructive
# admin actions require a valid 6-digit code (WS03-07 MFA).
ADMIN_TOTP_SECRET=

# Optional global passcode gate (empty = open). Master-admin allow-list.
APP_PASSCODE=
ADMIN_EMAILS=
# Shared secret protecting the cron reminder endpoint (empty = disabled).
REMINDER_TOKEN=

# Google Sign-In: the OAuth *Web client ID* (public; embedded in the frontend).
# The backend verifies ID tokens against it. No client SECRET is needed here.
GOOGLE_CLIENT_ID=
